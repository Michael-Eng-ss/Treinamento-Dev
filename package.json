{
  "name": "treinamento-dev",
  "version": "1.0.0",
  "description": "Inicialmente um repository de guardar treinamento",
  "homepage": "https://github.com/Michael-Eng-ss/Treinamento-Dev#readme",
  "bugs": {
    "url": "https://github.com/Michael-Eng-ss/Treinamento-Dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-Eng-ss/Treinamento-Dev.git"
  },
  "license": "MIT",
  "author": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:start:d && npm run migrations:up && next dev",
    "dev:remote": "npm run migrations:up:remote && next dev",
    "build": "next build",
    "start": "next start",
    "services:stop": "docker compose -f ./infra/compose.yaml stop",
    "services:start": "docker compose -f ./infra/compose.yaml up",
    "services:start:d": "docker compose -f ./infra/compose.yaml up -d",
    "services:start:build": "docker compose -f ./infra/compose.yaml up --build",
    "services:logs": "docker compose -f ./infra/compose.yaml logs -f",
    "services:down": "docker compose -f ./infra/compose.yaml down",
    "lint": "next lint",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest --runInBand",
    "test:watch": "jest --watchAll  --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "migrations:create": "node-pg-migrate --migrations-dir ./infra/migrations create",
    "migrations:up": "node infra/scripts/wait-for-postgres.js && node-pg-migrate --migrations-dir ./infra/migrations --envPath .env up",
    "migrations:up:remote": "node-pg-migrate --migrations-dir ./infra/migrations --envPath .env.development up",
    "migrations:down": "node-pg-migrate --migrations-dir ./infra/migrations --envPath .env down",
    "migrations:down:remote": "node-pg-migrate --migrations-dir ./infra/migrations --envPath .env.development down"
  },
  "dependencies": {
    "dotenv": "^16.4.4",
    "dotenv-expand": "^11.0.6",
    "next": "^13.1.6",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.8.3"
  }
}
